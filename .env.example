# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://syncscript:syncscript@localhost:5432/syncscript

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Auth — generate strong values for anything beyond local development,
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
